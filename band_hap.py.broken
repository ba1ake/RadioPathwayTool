"""
Independent per-band SWS HAP collector.

The normal HAP product contains multiple candidate frequencies in one
colour-coded map.  That product is retained by band_favorability.py.

This module instead requests ONE frequency at a time from the SWS HAP CGI.

That allows RadioPathwayTool to independently answer:

    "Does SWS HAP support 20m at this grid point?"

rather than interpreting the multi-frequency HAP recommendation map as
nine separate availability maps.

The result is deliberately expressed as HAP support counts/booleans, not
as a 0-100 propagation score or probability.
"""

from __future__ import annotations

from concurrent.futures import ThreadPoolExecutor, as_completed
from dataclasses import dataclass
from datetime import datetime, timezone
from hashlib import sha1
from pathlib import Path
import re
from typing import Any
from urllib.parse import urljoin

import requests
from PIL import Image


SWS_HAP_CGI = (
    "https://www.sws.bom.gov.au/"
    "local-cgi-bin/phapj-cgi.tcl"
)

CACHE_DIR = Path(".hap_band_cache")
CACHE_SECONDS = 300
REQUEST_TIMEOUT = 30

BANDS: dict[str, int] = {
    "160m": 1838,
    "80m": 3650,
    "40m": 7150,
    "30m": 10125,
    "20m": 14175,
    "17m": 18118,
    "15m": 21225,
    "12m": 24940,
    "10m": 28850,
}

# These are the same map colours used by the existing HAP decoder.
# A single-frequency HAP request should only contain one frequency colour.
HAP_COLOURS = {
    (255, 255, 255),  # white = no recommendation
    (0, 128, 0),
    (255, 255, 0),
    (128, 128, 0),
    (255, 0, 0),
    (0, 255, 255),
    (0, 255, 0),
    (0, 128, 128),
    (0, 0, 255),
    (0, 0, 128),
}

HAP_SUPPORT_COLOURS = {
    colour
    for colour in HAP_COLOURS
    if colour != (255, 255, 255)
}

HAP_MAP_X_MIN = 12
HAP_MAP_X_MAX = 289
HAP_MAP_Y_MIN = 2
HAP_MAP_Y_MAX = 178

EDGE_INSET = 2

PANEL_BOXES = [
    (50, 134, 340, 313),
    (360, 134, 650, 313),
    (50, 381, 340, 560),
    (360, 381, 650, 560),
    (50, 631, 340, 808),
    (360, 631, 650, 808),
]


@dataclass(frozen=True)
class IndependentHAPPoint:
    row: int
    col: int
    latitude: float
    longitude: float
    pixel_x: float
    pixel_y: float


class IndependentHAPCollector:
    """
    Collect independent HAP predictions for each configured amateur band.
    """

    def __init__(
        self,
        cache_dir: Path | str = CACHE_DIR,
    ) -> None:
        self.cache_dir = Path(cache_dir)
        self.cache_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

        self.session = requests.Session()

        self.session.headers.update(
            {
                "User-Agent":
                    "RadioPathwayTool/1.0 "
                    "(HF propagation research)",
            }
        )

    # ------------------------------------------------------------------
    # URL
    # ------------------------------------------------------------------

    @staticmethod
    def build_url(
        config: Any,
        frequency_khz: int,
        timestamp_utc: datetime | None = None,
    ) -> str:
        """
        Build an SWS HAP request containing exactly one frequency.
        """

        if timestamp_utc is None:
            timestamp_utc = datetime.now(timezone.utc)

        timestamp_utc = timestamp_utc.astimezone(timezone.utc)

        params = [
            ("baslat", f"{float(config.base_lat):.4f}"),
            ("baslng", f"{float(config.base_lon):.4f}"),
            ("basename", str(config.base_name)),
            ("numfreqs", "1"),
            ("year", str(timestamp_utc.year)),
            ("month", str(timestamp_utc.month)),
            ("day", str(timestamp_utc.day)),
            ("tindex", str(int(config.tindex))),
            ("nwlat", f"{float(config.nw_lat):.4f}"),
            ("nwlng", f"{float(config.nw_lon):.4f}"),
            ("steplat", f"{float(config.step_lat):.4f}"),
            ("steplng", f"{float(config.step_lon):.4f}"),
            ("nrows", str(int(config.nrows))),
            ("ncols", str(int(config.ncols))),
            ("freq1", str(int(frequency_khz))),
            ("freq2", ""),
            ("freq3", ""),
            ("freq4", ""),
            ("freq5", ""),
            ("freq6", ""),
            ("freq7", ""),
            ("freq8", ""),
            ("freq9", ""),
            ("freq10", ""),
        ]

        from urllib.parse import urlencode

        return (
            SWS_HAP_CGI
            + "?"
            + urlencode(params)
        )

    # ------------------------------------------------------------------
    # Cache
    # ------------------------------------------------------------------

    @staticmethod
    def _cache_name(
        prefix: str,
        value: str,
    ) -> Path:
        digest = sha1(
            value.encode("utf-8")
        ).hexdigest()

        return CACHE_DIR / f"{prefix}_{digest}"

    def _read_cache(
        self,
        path: Path,
    ) -> bytes | None:
        try:
            if not path.exists():
                return None

            age = (
                datetime.now().timestamp()
                - path.stat().st_mtime
            )

            if age > CACHE_SECONDS:
                return None

            return path.read_bytes()

        except Exception:
            return None

    def _write_cache(
        self,
        path: Path,
        data: bytes,
    ) -> None:
        try:
            path.parent.mkdir(
                parents=True,
                exist_ok=True,
            )

            path.write_bytes(data)

        except Exception:
            pass

    # ------------------------------------------------------------------
    # HTTP
    # ------------------------------------------------------------------

    def fetch(
        self,
        url: str,
    ) -> str:
        cache_path = self._cache_name(
            "html",
            url,
        )

        cached = self._read_cache(
            cache_path
        )

        if cached is not None:
            return cached.decode(
                "utf-8",
                errors="replace",
            )

        response = self.session.get(
            url,
            timeout=REQUEST_TIMEOUT,
        )

        response.raise_for_status()

        content = response.content

        self._write_cache(
            cache_path,
            content,
        )

        return response.text

    def download_image(
        self,
        url: str,
    ) -> Image.Image:

        cache_path = self._cache_name(
            "gif",
            url,
        )

        cached = self._read_cache(
            cache_path
        )

        if cached is None:

            response = self.session.get(
                url,
                timeout=REQUEST_TIMEOUT,
            )

            response.raise_for_status()

            cached = response.content

            self._write_cache(
                cache_path,
                cached,
            )

        from io import BytesIO

        image = Image.open(
            BytesIO(cached)
        )

        return image.convert("RGB")

    # ------------------------------------------------------------------
    # HTML / images
    # ------------------------------------------------------------------

    @staticmethod
    def extract_image_urls(
        html: str,
        page_url: str,
    ) -> list[str]:

        matches = re.findall(
            r"""(?:src|SRC)\s*=\s*["']([^"']+)["']""",
            html,
        )

        urls: list[str] = []

        for source in matches:

            lower = source.lower()

            if ".gif" not in lower:
                continue

            url = urljoin(
                page_url,
                source,
            )

            if url not in urls:
                urls.append(url)

        return urls

    @staticmethod
    def extract_hour_panels(
        images: list[Image.Image],
    ) -> dict[int, Image.Image]:

        panels: dict[int, Image.Image] = {}

        hour = 0

        for image in images:

            for box in PANEL_BOXES:

                panel = image.crop(
                    box
                )

                panels[hour] = panel

                hour += 1

                if hour >= 24:
                    return panels

        return panels

    # ------------------------------------------------------------------
    # Grid
    # ------------------------------------------------------------------

    @staticmethod
    def build_grid(
        config: Any,
    ) -> list[IndependentHAPPoint]:

        points: list[IndependentHAPPoint] = []

        lat_span = (
            (config.nrows - 1)
            * config.step_lat
        )

        lon_span = (
            (config.ncols - 1)
            * config.step_lon
        )

        se_lat = (
            config.nw_lat
            + lat_span
        )

        se_lon = (
            config.nw_lon
            + lon_span
        )

        for row in range(
            config.nrows
        ):

            latitude = (
                config.nw_lat
                + row * config.step_lat
            )

            for col in range(
                config.ncols
            ):

                longitude = (
                    config.nw_lon
                    + col * config.step_lon
                )

                if lon_span:
                    fraction_x = (
                        longitude
                        - config.nw_lon
                    ) / lon_span
                else:
                    fraction_x = 0.5

                if lat_span:
                    fraction_y = (
                        latitude
                        - config.nw_lat
                    ) / lat_span
                else:
                    fraction_y = 0.5

                x = (
                    HAP_MAP_X_MIN
                    + fraction_x
                    * (
                        HAP_MAP_X_MAX
                        - HAP_MAP_X_MIN
                    )
                )

                y = (
                    HAP_MAP_Y_MIN
                    + fraction_y
                    * (
                        HAP_MAP_Y_MAX
                        - HAP_MAP_Y_MIN
                    )
                )

                x = max(
                    HAP_MAP_X_MIN + EDGE_INSET,
                    min(
                        HAP_MAP_X_MAX - EDGE_INSET,
                        x,
                    ),
                )

                y = max(
                    HAP_MAP_Y_MIN + EDGE_INSET,
                    min(
                        HAP_MAP_Y_MAX - EDGE_INSET,
                        y,
                    ),
                )

                points.append(
                    IndependentHAPPoint(
                        row=row,
                        col=col,
                        latitude=latitude,
                        longitude=longitude,
                        pixel_x=x,
                        pixel_y=y,
                    )
                )

        return points

    # ------------------------------------------------------------------
    # Pixel decoding
    # ------------------------------------------------------------------

    @staticmethod
    def _pixel_is_support(
        pixel: tuple[int, int, int],
    ) -> bool:
        return pixel in HAP_SUPPORT_COLOURS

    @classmethod
    def sample_point(
        cls,
        panel: Image.Image,
        point: IndependentHAPPoint,
        radius: int = 2,
    ) -> int:
        """
        Return the number of HAP-support pixels in a 5x5 sample.

        The result is deliberately a raw sample count.

        It is NOT a probability, percentage, signal-strength estimate,
        or communication success score.
        """

        x0 = int(round(point.pixel_x))
        y0 = int(round(point.pixel_y))

        support = 0

        for dy in range(
            -radius,
            radius + 1,
        ):

            for dx in range(
                -radius,
                radius + 1,
            ):

                x = x0 + dx
                y = y0 + dy

                if (
                    x < 0
                    or y < 0
                    or x >= panel.width
                    or y >= panel.height
                ):
                    continue

                pixel = panel.getpixel(
                    (x, y)
                )

                if cls._pixel_is_support(
                    pixel
                ):
                    support += 1

        return support

    # ------------------------------------------------------------------
    # One band
    # ------------------------------------------------------------------

    def collect_band(
        self,
        config: Any,
        band: str,
        frequency_khz: int,
        timestamp_utc: datetime | None = None,
    ) -> dict[int, dict[str, Any]]:

        url = self.build_url(
            config=config,
            frequency_khz=frequency_khz,
            timestamp_utc=timestamp_utc,
        )

        html = self.fetch(
            url
        )

        image_urls = self.extract_image_urls(
            html,
            url,
        )

        if len(image_urls) < 4:
            raise RuntimeError(
                f"SWS returned only "
                f"{len(image_urls)} GIF images "
                f"for {band}"
            )

        image_urls = image_urls[:4]

        images = [
            self.download_image(
                image_url
            )
            for image_url in image_urls
        ]

        panels = self.extract_hour_panels(
            images
        )

        points = self.build_grid(
            config
        )

        result: dict[
            int,
            dict[str, Any]
        ] = {}

        for hour in range(24):

            panel = panels.get(
                hour
            )

            if panel is None:
                result[hour] = {
                    "supported": False,
                    "support": 0,
                    "supported_grid_points": 0,
                    "grid_points": 49,
                    "frequency_khz": frequency_khz,
                    "frequency_mhz": (
                        frequency_khz / 1000.0
                    ),
                    "error": (
                        "Missing HAP panel"
                    ),
                }

                continue

            grid_support = []

            for point in points:

                support = self.sample_point(
                    panel,
                    point,
                )

                grid_support.append(
                    {
                        "row": point.row,
                        "col": point.col,
                        "latitude": point.latitude,
                        "longitude": point.longitude,
                        "support": support,
                        "supported": support > 0,
                    }
                )

            supported_count = sum(
                1
                for point in grid_support
                if point["supported"]
            )

            # The base-point result is the grid point closest to row/col
            # corresponding to the configured base.
            base_point = min(
                grid_support,
                key=lambda item: (
                    abs(
                        item["latitude"]
                        - config.base_lat
                    )
                    + abs(
                        item["longitude"]
                        - config.base_lon
                    )
                ),
            )

            result[hour] = {
                "supported": bool(
                    base_point["supported"]
                ),
                "support": int(
                    base_point["support"]
                ),
                "supported_grid_points": (
                    supported_count
                ),
                "grid_points": len(
                    grid_support
                ),
                "frequency_khz": frequency_khz,
                "frequency_mhz": (
                    frequency_khz / 1000.0
                ),
                "grid": grid_support,
            }

        return result

    # ------------------------------------------------------------------
    # All bands
    # ------------------------------------------------------------------

    def collect_all(
        self,
        config: Any,
        timestamp_utc: datetime | None = None,
    ) -> tuple[
        dict[str, dict[int, dict[str, Any]]],
        dict[str, str],
    ]:
        """
        Collect all nine bands.

        Requests are performed concurrently because every band is an
        independent SWS request.

        Returns:

            (results, errors)
        """

        results: dict[
            str,
            dict[int, dict[str, Any]]
        ] = {}

        errors: dict[
            str,
            str
        ] = {}

        with ThreadPoolExecutor(
            max_workers=4
        ) as executor:

            futures = {
                executor.submit(
                    self.collect_band,
                    config,
                    band,
                    frequency_khz,
                    timestamp_utc,
                ): band
                for band, frequency_khz
                in BANDS.items()
            }

            for future in as_completed(
                futures
            ):

                band = futures[
                    future
                ]

                try:

                    results[band] = (
                        future.result()
                    )

                except Exception as exc:

                    errors[band] = (
                        f"{type(exc).__name__}: "
                        f"{exc}"
                    )

        # Preserve configured band ordering.
        ordered = {
            band: results[band]
            for band in BANDS
            if band in results
        }

        return ordered, errors
